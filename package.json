{
	"name": "@favware/graphql-pokemon",
	"version": "8.8.2",
	"description": "Extensive Pokemon GraphQL API",
	"keywords": [
		"favware",
		"graphql",
		"ts",
		"typescript",
		"yarn"
	],
	"homepage": "https://graphql-pokemon.js.org/",
	"bugs": {
		"url": "https://github.com/favware/graphql-pokemon/issues"
	},
	"license": "MIT",
	"author": "@favware",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/favware/graphql-pokemon.git"
	},
	"files": [
		"dist/",
		"graphql/"
	],
	"type": "module",
	"sideEffects": [
		"./src/lib/assets/pokedex.ts",
		"./src/lib/assets/pokedex-data/*.ts",
		"./api/lib/assets/pokedex.js",
		"./api/lib/assets/pokedex-data/*.js"
	],
	"main": "dist/codegen/cjs/graphql-pokemon.cjs",
	"module": "dist/codegen/esm/graphql-pokemon.mjs",
	"types": "dist/codegen/cjs/graphql-pokemon.d.cts",
	"imports": {
		"#assets/*": "./api/lib/assets/*.js",
		"#jsonAssets/*": "./api/lib/assets/*.json",
		"#dexdata/*": "./api/lib/assets/pokedex-data/*.js",
		"#resolvers/*": "./api/lib/resolvers/*.js",
		"#types/*": "./api/lib/types/*.js",
		"#utils/*": "./api/lib/utils/*.js",
		"#validations/*": "./api/lib/validations/*.js",
		"#mappers/*": "./api/lib/mappers/*.js",
		"#root/*": "./api/*.js"
	},
	"exports": {
		".": {
			"import": {
				"types": "./dist/codegen/esm/graphql-pokemon.d.mts",
				"default": "./dist/codegen/esm/graphql-pokemon.mjs"
			},
			"require": {
				"types": "./dist/codegen/cjs/graphql-pokemon.d.cts",
				"default": "./dist/codegen/cjs/graphql-pokemon.cjs"
			}
		},
		"./utilities": {
			"import": {
				"types": "./dist/utilities/esm/index.d.mts",
				"default": "./dist/utilities/esm/index.mjs"
			},
			"require": {
				"types": "./dist/utilities/cjs/index.d.cts",
				"default": "./dist/utilities/cjs/index.cjs"
			}
		}
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"lint": "oxlint --fix",
		"lint:github": "oxlint --format=github",
		"format": "oxfmt",
		"test": "vitest run",
		"typecheck": "tsc -b src && tsc -b tests",
		"start": "node --enable-source-maps api/index.js",
		"build": "tsdown",
		"watch": "tsdown --watch",
		"docs": "yarn magidoc generate -f ./docs/magidoc.mjs",
		"dev": "yarn build && yarn start",
		"clean": "rimraf codegen/ dist/ api/",
		"bump": "cliff-jumper",
		"check-update": "cliff-jumper --dry-run",
		"package": "graphql-codegen && yarn package:compile",
		"package:compile": "tsdown --config tsdown.config-package.ts",
		"au:tiers": "unrun ./scripts/data-gen-scripts/scripted-updaters/asset-updaters/tiers-updater.ts",
		"au:learnsets": "unrun ./scripts/data-gen-scripts/scripted-updaters/asset-updaters/learnsets-updater.ts",
		"au:testdata": "unrun ./scripts/data-gen-scripts/scripted-updaters/update-test-files.ts",
		"au:flavors": "unrun ./scripts/data-gen-scripts/scripted-updaters/flavor-text-updater/flavor-text-updater.ts",
		"au:classifications": "unrun ./scripts/data-gen-scripts/scripted-updaters/classification-updater/classification-updater.ts",
		"au:ipa": "unrun ./scripts/data-gen-scripts/scripted-updaters/ipa-name-updater/ipa-updater.ts",
		"au:abilities": "unrun ./scripts/data-gen-scripts/scripted-updaters/asset-updaters/abilities-updater.ts",
		"au:items": "unrun ./scripts/data-gen-scripts/scripted-updaters/asset-updaters/items-updater.ts",
		"au:moves": "unrun ./scripts/data-gen-scripts/scripted-updaters/asset-updaters/moves-updater.ts",
		"au:cries": "unrun ./scripts/data-gen-scripts/scripted-updaters/cries-updater/cry-updater.ts"
	},
	"dependencies": {
		"graphql": "16.14.2"
	},
	"devDependencies": {
		"@apollo/server": "^5.5.1",
		"@as-integrations/koa": "^3.0.0",
		"@commitlint/cli": "^21.2.4",
		"@commitlint/config-conventional": "^21.2.4",
		"@discordjs/collection": "^2.1.1",
		"@favware/cliff-jumper": "^6.1.0",
		"@graphql-codegen/cli": "^6.3.1",
		"@graphql-codegen/schema-ast": "^6.1.1",
		"@graphql-codegen/typescript": "^6.1.2",
		"@graphql-codegen/typescript-resolvers": "^6.1.1",
		"@koa/bodyparser": "^6.1.0",
		"@koa/cors": "^5.0.0",
		"@magidoc/cli": "^7.0.0",
		"@sapphire/fetch": "^3.0.5",
		"@sapphire/shapeshift": "^4.0.0",
		"@sapphire/timestamp": "^1.0.5",
		"@sapphire/ts-config": "^5.0.3",
		"@skyra/jaro-winkler": "^1.1.1",
		"@types/async": "^3.2.26",
		"@types/cheerio": "^1.0.0",
		"@types/koa": "^3.0.3",
		"@types/koa__cors": "^5.0.1",
		"@types/node": "^25.9.9",
		"@vitest/coverage-v8": "^5.0.5",
		"async": "^3.2.6",
		"cheerio": "^1.2.0",
		"colorette": "^2.0.20",
		"cz-conventional-changelog": "^3.3.0",
		"eslint-config-neon": "^0.5.4",
		"graphql-tag": "^2.12.7",
		"json-stream-stringify": "^3.1.7",
		"koa": "^3.2.1",
		"lint-staged": "^17.6.0",
		"npm-run-all2": "^9.0.4",
		"oxc-transform": "^0.155.0",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"rimraf": "^6.1.3",
		"tsdown": "0.23.1",
		"typescript": "~7.0.2",
		"unplugin-replace": "^0.9.1",
		"unrun": "^0.3.1",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"resolutions": {
		"graphql@npm:16.14.0": "patch:graphql@npm%3A16.14.2#~/.yarn/patches/graphql-npm-16.14.2-3f85a393fd.patch",
		"graphql@npm:16.14.2": "patch:graphql@npm%3A16.14.2#~/.yarn/patches/graphql-npm-16.14.2-3f85a393fd.patch"
	},
	"lint-staged": {
		"!(*.mjs|*.js|*.ts)": "oxfmt --no-error-on-unmatched-pattern",
		"*.{mjs,js,ts}": [
			"oxlint --fix --no-error-on-unmatched-pattern",
			"oxfmt --no-error-on-unmatched-pattern"
		]
	},
	"commitlint": {
		"extends": [
			"@commitlint/config-conventional"
		]
	},
	"config": {
		"commitizen": {
			"path": "./node_modules/cz-conventional-changelog"
		}
	},
	"packageManager": "yarn@4.18.1"
}
